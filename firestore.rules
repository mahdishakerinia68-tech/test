rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // License links need to be readable without a customer account.
    // IMPORTANT: clients must NEVER be allowed to create/edit/revoke licenses.
    match /licenseRegistry/{licenseId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.token.email != null && request.auth.token.email == 'mahdishakerinia68@gmail.com';
    }
    // Keep your existing application rules for all other collections.
  }
}
