rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/licenses/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/licenses/$(request.auth.uid)).data.isAdmin == true;
    }

    // Each user's own license doc: they may read only their own (to check
    // their own status); only an admin may create/update/delete any
    // license doc (creating new accounts, renewing, revoking).
    match /licenses/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Existing two-device sync data: unchanged, still fully private to
    // each signed-in user's own uid.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /records/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /devices/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
