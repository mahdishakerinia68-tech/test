rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isPrimary() { return request.auth != null && request.auth.token.email == 'mahdishakerinia68@gmail.com'; }
    function isAdmin() {
      return isPrimary() || (request.auth != null && exists(/databases/$(database)/documents/licenseAdmins/$(request.auth.token.email)) && get(/databases/$(database)/documents/licenseAdmins/$(request.auth.token.email)).data.enabled == true);
    }
    match /licenseRegistry/{licenseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /licenseAdmins/{adminEmail} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.email == adminEmail;
      allow delete: if isAdmin() || isPrimary();
    }
  }
}
